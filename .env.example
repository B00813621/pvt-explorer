# PVT Explorer — variables serveur uniquement. Ne jamais publier ce fichier rempli.
PORT=3000
NODE_ENV=production

# Assistant IA (facultatif tant que la clé n'est pas créée)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Administration : générer un secret aléatoire long (32+ caractères)
ADMIN_TOKEN=REMPLACER_PAR_UN_SECRET_LONG_ALEATOIRE

# Amazon Partenaires France : identifiant approuvé, ex. monsite-21
AMAZON_PARTNER_TAG=

# URLs de suivi affiliées exactes fournies par chaque plateforme (ne pas inventer)
PARTNER_FLIGHTS_URL=
PARTNER_STAYS_URL=
PARTNER_INSURANCE_URL=
PARTNER_ESIM_URL=
PARTNER_ACTIVITIES_URL=
PARTNER_CAR_URL=

# Brevo : double opt-in obligatoire. Créer une liste, un modèle DOI et une page de confirmation.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_REDIRECT_URL=https://votre-domaine.fr/inscription-confirmee.html

# AdSense : ne pas activer avant acceptation du site + CMP certifiée/compatible et testée.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_DESTINATIONS=
ADSENSE_SLOT_CONTENT=
